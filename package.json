{
  "name": "duelingbookenhanced",
  "version": "0.2.2",
  "description": "A Chrome extension to bring QOL additions to DuelingBook.com",
  "main": "index.js",
  "scripts": {
    "start": "webpack watch --config webpack/webpack.dev.js",
    "watch": "webpack --config webpack/webpack.dev.js --watch",
    "build": "npx tsc && webpack --config webpack/webpack.prod.js && npm run build:tailwind",
    "build:tailwind": "npx tailwindcss build -i src/styles/tailwind.css -o dist/css/output.css",
    "clean": "rimraf dist",
    "test": "npx jest",
    "style": "prettier --write \"src/**/*.{ts,tsx}\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "prepare": "husky"
  },
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexjraymond/DuelingBookEnhanced.git"
  },
  "dependencies": {
    "lodash": "4.17.21",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "4.12.0"
  },
  "devDependencies": {
    "@types/chrome": "0.0.158",
    "@types/jest": "29.5.8",
    "@types/lodash": "4.14.201",
    "@types/react": "18.2.37",
    "@types/react-dom": "18.2.15",
    "@typescript-eslint/eslint-plugin": "8.52.0",
    "@typescript-eslint/parser": "8.52.0",
    "copy-webpack-plugin": "9.1.0",
    "css-loader": "6.8.1",
    "eslint": "8.57.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "file-loader": "6.2.0",
    "glob": "7.2.3",
    "html-webpack-plugin": "5.5.3",
    "husky": "9.1.7",
    "jest": "29.7.0",
    "lint-staged": "16.2.7",
    "prettier": "2.8.8",
    "rimraf": "3.0.2",
    "style-loader": "3.3.3",
    "tailwindcss": "3.3.5",
    "ts-jest": "29.1.1",
    "ts-loader": "8.4.0",
    "typescript": "5.2.2",
    "webpack": "5.89.0",
    "webpack-cli": "4.10.0",
    "webpack-dev-server": "4.15.1",
    "webpack-merge": "5.10.0"
  }
}
