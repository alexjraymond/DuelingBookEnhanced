{
	"private": true,
	"scripts": {
		"build": "rm -r -f dist && NODE_NO_WARNINGS=1 parcel build",
		"lint": "run-p lint:*",
		"lint-fix": "run-p 'lint:* -- --fix'",
		"lint:css": "stylelint src/**/*.css",
		"lint:js": "xo",
		"test": "run-p lint:* build",
		"watch": "NODE_NO_WARNINGS=1 parcel watch --watch-dir src --no-hmr --no-cache",
		"watch:chrome": "web-ext run -t chromium"
	},
	"browserslist": [
		"last 1 Chrome version",
		"last 1 Firefox version"
	],
	"xo": {
		"envs": [
			"browser",
			"webextensions"
		],
		"rules": {
			"unicorn/prefer-top-level-await": "off"
		}
	},
	"stylelint": {
		"extends": [
			"stylelint-config-xo"
		],
		"rules": {}
	},
	"dependencies": {
		"@parcel/bundler-default": "^2.13.0",
		"chrome-types": "^0.1.321",
		"hotkeys-js": "^3.13.7",
		"jsdoc": "^4.0.4",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-icons": "^5.3.0",
		"styled-components": "^6.1.13",
		"webext-base-css": "^2.0.1",
		"webext-options-sync": "4.3.0"
	},
	"devDependencies": {
		"@babel/core": "^7.26.0",
		"@eslint/js": "^9.15.0",
		"@parcel/config-webextension": "^2.13.0",
		"@parcel/resolver-default": "^2.13.0",
		"@styled/typescript-styled-plugin": "^1.0.1",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-prettier": "^5.2.1",
		"eslint-plugin-react": "^7.37.2",
		"globals": "^15.12.0",
		"npm-run-all2": "^7.0.1",
		"parcel": "^2.13.0",
		"postcss": "^8.4.49",
		"process": "^0.11.10",
		"stylelint": "^16.6.1",
		"stylelint-config-prettier": "^9.0.5",
		"stylelint-config-xo": "^1.0.2",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.6.3",
		"xo": "^0.59.3"
	},
	"@parcel/resolver-default": {
		"packageExports": true
	},
	"targets": {
		"default": {
			"source": "src/manifest.json",
			"distDir": "./dist"
		}
	},
	"webExt": {
		"sourceDir": "dist",
		"run": {
			"startUrl": [
				"https://github.com/fregante/browser-extension-template"
			]
		}
	}
}
